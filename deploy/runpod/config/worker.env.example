# CosmicEngine worker pod environment for RunPod.
#
# Replace <HEAD_HOST>:<HEAD_PORT> with the connection details of your
# Ray head pod. Two ways to get them:
#
# 1) Same-account / same-region pods can use RunPod's internal
#    networking by referencing the head's pod hostname (visible on
#    the pod's networking tab).
#
# 2) Cross-region or external clusters must use the head pod's
#    public proxy URL (https://<HEAD_POD_ID>-6379.proxy.runpod.net or
#    similar) — note that Ray's GCS does not run over HTTPS, so for
#    multi-region you'll need a TCP proxy / VPN of your own.

COSMIC_ROLE=worker
COSMIC_RAY_ADDRESS=<HEAD_HOST>:6379
COSMIC_HEAD_IP=<HEAD_HOST>
COSMIC_HEAD_PORT=6379
COSMIC_DATA_DIR=/workspace/data
COSMIC_MODEL_DIR=/workspace/models
COSMIC_OUTPUT_DIR=/workspace/outputs
COSMIC_ENABLE_GPU=true
COSMIC_NODE_NAME=runpod-worker
