# CosmicEngine runtime / API pod environment for RunPod.
#
# Set these as "Environment Variables" on the RunPod pod template
# (Web UI → Templates → Edit → Environment Variables) or via
# `runpodctl create pod --env COSMIC_ROLE=runtime ...`.
#
# Notes:
# - COSMIC_RAY_ADDRESS=auto: start a fresh local Ray runtime on this
#   pod. Use ${HEAD_HOST}:6379 from a worker pod instead.
# - The internal listen port stays 8765 even when RunPod exposes it
#   on a different external proxy port — clients connect via the
#   proxy URL printed on the pod's "Connect" tab.

COSMIC_ROLE=runtime
COSMIC_RAY_ADDRESS=auto
COSMIC_RUNTIME_HOST=0.0.0.0
COSMIC_RUNTIME_PORT=8765
COSMIC_DATA_DIR=/workspace/data
COSMIC_MODEL_DIR=/workspace/models
COSMIC_OUTPUT_DIR=/workspace/outputs
COSMIC_ENABLE_GPU=true
COSMIC_NODE_NAME=runpod-runtime
