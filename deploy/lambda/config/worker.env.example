# CosmicEngine worker node environment.
#
# Replace <HEAD_NODE_IP> with the head node's private (or public)
# IP. Workers join the Ray cluster started on the head node.

COSMIC_ROLE=worker
COSMIC_RAY_ADDRESS=<HEAD_NODE_IP>:6379
COSMIC_HEAD_IP=<HEAD_NODE_IP>
COSMIC_HEAD_PORT=6379
COSMIC_DATA_DIR=/workspace/data
COSMIC_MODEL_DIR=/workspace/models
COSMIC_OUTPUT_DIR=/workspace/outputs
COSMIC_ENABLE_GPU=true
COSMIC_NODE_NAME=lambda-worker
COSMIC_LAMBDA_INSTANCE_TYPE=gpu_1x_a10
