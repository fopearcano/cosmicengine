# CosmicEngine runtime / API node environment.
#
# Copy to runtime.env and load with `--env-file runtime.env` when
# running the container, or `set -a; . runtime.env; set +a` on a
# bare Lambda instance.

COSMIC_ROLE=runtime
COSMIC_RAY_ADDRESS=auto
COSMIC_RUNTIME_HOST=0.0.0.0
COSMIC_RUNTIME_PORT=8765
COSMIC_DATA_DIR=/workspace/data
COSMIC_MODEL_DIR=/workspace/models
COSMIC_OUTPUT_DIR=/workspace/outputs
COSMIC_ENABLE_GPU=true
COSMIC_NODE_NAME=lambda-runtime
COSMIC_LAMBDA_INSTANCE_TYPE=gpu_1x_a10
