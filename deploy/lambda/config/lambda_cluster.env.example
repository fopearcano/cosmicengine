# Cluster-wide environment shared by every CosmicEngine Lambda node.
#
# Source this on every instance before launching the role-specific
# scripts so paths and ports stay consistent across the cluster.

# IP of the head node (Ray head + CosmicRuntime). Use the *private*
# Lambda IP when the worker pool is in the same VPC; use the public
# IP only when nodes live in different networks.
HEAD_NODE_IP=

# Standard ports.
RAY_PORT=6379
RAY_DASHBOARD_PORT=8265
RAY_CLIENT_PORT=10001
RUNTIME_PORT=8765

# Persistent storage roots. On Lambda these are typically a mounted
# attached filesystem so all nodes see the same data / models /
# outputs. /workspace is the convention used by every Dockerfile.
DATA_DIR=/workspace/data
MODEL_DIR=/workspace/models
OUTPUT_DIR=/workspace/outputs
